# Pony Agent —— 部署配置模板（PonySentry 凭证与 ingest 端点）
#
# wave-18 C6：本文件只记录【变量用途 / 未设时的默认值 / 自检方式】，不含任何真实凭证。
# 复制为 .env（或按部署平台注入环境变量）后按需填写。
# 设计原则：**未设即 fail-closed 零 egress** —— 不配置就完全不上报。
#
# ---------------------------------------------------------------------------
# 1) 后端（Rust core / src-tauri）—— 契约 C2
# ---------------------------------------------------------------------------

# 用途：后端 ingest 端点。
# 默认值：未设或纯空白 => 回落 https://sentry.ponyjob.top（非凭证，允许保留默认值）。
PONYSENTRY_INGEST_URL=https://sentry.ponyjob.top

# 用途：后端鉴权 token（唯一合法来源；代码中不存在任何硬编码回落）。
# 默认值：未设 / set-but-empty / 纯空白 => None
#         => 默认不发 `X-Client-Token` 头，服务端应拒绝无鉴权请求。
PONYSENTRY_CLIENT_TOKEN=<your-backend-client-token>

# ---------------------------------------------------------------------------
# 2) 前端（Vue 3 / Vite）—— 契约 C5
# ---------------------------------------------------------------------------

# 用途：前端 ingest 端点。
# 默认值：未设 / 空串 => ""（**不发起 fetch**，零 egress）。
VITE_PONYSENTRY_INGEST_URL=<your-frontend-ingest-url>

# 用途：前端鉴权 token。
# 默认值：未设 / 空串 => ""（**不发起 fetch、不携带 X-Client-Token 头**）。
VITE_PONYSENTRY_CLIENT_TOKEN=<your-frontend-client-token>

# ---------------------------------------------------------------------------
# 3) 恢复上报的最小配置（默认 fail-closed，必须显式开启才会恢复上报）
# ---------------------------------------------------------------------------
# 后端：PONYSENTRY_CLIENT_TOKEN=<真实 token>（wave-18c：无独立开关变量，
#       有 token 即启用；桌面发布产物由 CI 经 PONYSENTRY_BUILD_CLIENT_TOKEN 烧录，无需配置）
# 前端：VITE_PONYSENTRY_INGEST_URL=<真实端点> 且 VITE_PONYSENTRY_CLIENT_TOKEN=<真实 token>
#
# 两者缺一即零 egress：后端不发请求、前端不发 fetch。占位示例（切勿提交真实凭证）：
# PONYSENTRY_CLIENT_TOKEN=<real-token>
# VITE_PONYSENTRY_INGEST_URL=https://sentry.example.com
# VITE_PONYSENTRY_CLIENT_TOKEN=<real-token>

# ---------------------------------------------------------------------------
# 4) Agent Trace 上报（OpenTelemetry → OTLP Collector → Langfuse；ADR 0047）
# ---------------------------------------------------------------------------
# 应用默认**不上报**：是否真的产生 span 由桌面端「配置 → 通用 → 全局 Agent Trace 上报」
# 开关（`settings.json` 的 `agentTraceReporting`，默认 false）决定；关闭时零 span 分配、零 egress。
# 下列变量只决定「开关打开后往哪里发、发什么身份」：
#   OTEL_SERVICE_NAME            Tempo / Langfuse 的检索主键，缺省 pony-agent
#   OTEL_EXPORTER_OTLP_ENDPOINT  集群内缺省 otel-collector.<ns>.svc.cluster.local:4318；
#                                桌面端（集群外）上线时填公网入口 https://otel.ponyjob.top
#   OTEL_TRACES_SAMPLER_ARG      采样率，缺省 1.0（用户显式授权 + 单机低频）
#   PONY_OTEL_TOKEN              公网入口的准入令牌（**裸 token，不要自己加 Bearer**）。
#                                客户端会自动组装成 `Authorization: Bearer <token>`
#                                （公网 edge 用 bearertokenauth，裸 token 会 401）。
#                                集群内直连 collector 时不需要
# 占位示例（切勿提交真实凭证）：
OTEL_SERVICE_NAME=pony-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
OTEL_TRACES_SAMPLER_ARG=1.0
PONY_OTEL_TOKEN=<optional-public-ingress-token>
#   PONY_OTEL_SERVICE_VERSION   覆写 trace resource 的 service.version（缺省=core crate 版本）
#   PONY_OTEL_ENVIRONMENT       覆写 deployment.environment（缺省 debug=development / release=production）
PONY_OTEL_SERVICE_VERSION=<optional-version-override>
PONY_OTEL_ENVIRONMENT=<optional-environment-override>

# ---------------------------------------------------------------------------
# 5) 自检
# ---------------------------------------------------------------------------
# 提交前必须通过敏感信息门禁（该命令必须 Exit 0）：
#   node scripts/check-secrets.mjs --all
