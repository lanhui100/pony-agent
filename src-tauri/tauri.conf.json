{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pony Agent",
  "version": "0.1.98",
  "identifier": "com.pony.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4176",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pony Agent",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 560,
        "maximized": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'",
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMzQ0MEQ2MjEzOUFDQTEKUldTaHJEa2gxa0EwMnZBMkRqRDJmM24zUzl2T1R3U1RQSlg1VjMyM2xxM2lhd1JweTJ6L2NyWjQK",
      "endpoints": [
        "https://github.com/lanhui100/pony-agent/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/taskbar-64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/StoreLogo.png"
    ]
  }
}
