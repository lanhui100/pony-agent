+    for line in payload_str.lines() {
+        if let Some(data) = line.strip_prefix("data: ") {
+            if let Ok(v) = serde_json::from_str::<Value>(data) {
+                if let Some(usage) = extract_anthropic_usage(&v) {
+                    return usage;
+                }
+            }
+        }
+    }
+    TokenUsage::default()
 }
 
