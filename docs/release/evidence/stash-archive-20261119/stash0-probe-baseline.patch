+/// 为什么复用器里不能带 `REPORT_ALL_KEYS_AS_ESCAPE_CODES`(8)：该位会把**每一个**按键都编码成
+/// `CSI <code>;<mods> u`。复用器对 push/pop 的转发不保证对称，一旦 pop 丢失（pane 被关、
+/// SIGHUP、代理层重建），用户在 shell 里敲任何键都会吐出 `u` / `3u` / `7u` 这类正文——
+/// 即「退出 TUI 后输入全是乱码」的真实形态。DISAMBIGUATE 已足够把 Shift+Enter 与裸 Enter
+/// 区分开（Shift+Enter 依赖的就是它），而普通键仍按传统编码发送：残留时最多是修饰键异常，
+/// 不会整个键盘变乱码。
+/// - 直连终端 ⇒ `DISAMBIGUATE | REPORT_ALL_KEYS`（保留既有全键位上报能力）
+pub fn keyboard_enhancement_push_flags_for(
+    term: Option<&str>,
+    multiplexer: Option<&str>,
+) -> Option<KeyboardEnhancementFlags> {
+    if !keyboard_enhancement_should_push_for(term) {
+        return None;
+    }
+    let mut flags = KeyboardEnhancementFlags::DISAMBIGUATE_ESCAPE_CODES;
+    if multiplexer.is_none() {
+        flags |= KeyboardEnhancementFlags::REPORT_ALL_KEYS_AS_ESCAPE_CODES;
+    }
+    Some(flags)
+}
+
+/// 运行时入口：读 `TERM` 与复用器环境后调用 [`keyboard_enhancement_push_flags_for`]。
+pub fn keyboard_enhancement_push_flags() -> Option<KeyboardEnhancementFlags> {
+    // 既有闸门先跑（`TERM` 缺失 / `dumb` 不 push），再按复用器环境决定带不带全键位上报。
+    if !keyboard_enhancement_should_push() {
+        return None;
+    }
+    keyboard_enhancement_push_flags_for(
+        std::env::var("TERM").ok().as_deref(),
+        terminal_multiplexer().as_deref(),
+    )
+}
