+/// 会转发按键的 pty 复用器 / 代理层环境变量（命中任一非空值即视为「按键透传不保证对称」）。
+///
+/// `HERDR` 是本机 pane 复用器；其余是常见终端复用器。共同点：它们自己不解析
+/// kitty 键盘协议，只把字节转发给外层终端，因此 push 能透传、pop 未必被对称转发。
+const TERMINAL_MULTIPLEXER_ENV_KEYS: [&str; 5] = ["HERDR", "TMUX", "ZELLIJ", "STY", "ABDUCO"];
+
+/// [`terminal_multiplexer`] 的纯函数内核：从注入的环境视图判定复用器名字。
+///
+/// 纯函数（注入 lookup）便于单测断言，避免测试里改全局环境变量。
+pub fn terminal_multiplexer_for_env(lookup: impl Fn(&str) -> Option<String>) -> Option<String> {
+    TERMINAL_MULTIPLEXER_ENV_KEYS.iter().find_map(|key| {
+        lookup(key)
+            .filter(|value| !value.trim().is_empty())
+            .map(|_| (*key).to_string())
+    })
+}
+
+/// 当前进程是否跑在 pty 复用器 / 代理层里（是则返回其环境变量名）。
+pub fn terminal_multiplexer() -> Option<String> {
+    terminal_multiplexer_for_env(|key| std::env::var(key).ok())
+}
+
+/// 启动时**实际**要 push 的键盘增强标志（纯函数内核，便于断言）。
+///
+/// - `TERM` 缺失 / `dumb` ⇒ `None`（不 push）
+/// - 复用器 / pty 代理层 ⇒ 只 `DISAMBIGUATE_ESCAPE_CODES`(1)
