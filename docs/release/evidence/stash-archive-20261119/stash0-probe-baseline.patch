+/// 续接行**恒在**；仅当终端还原不完整（输入侧还原串没送达）时追加一行手工恢复命令——
+/// 正常退出时多印这行只会让用户怀疑自己的终端坏了。
+pub fn resume_hint_block(session_id: &str, restore_incomplete: bool) -> String {
+    let mut block = format!("\n{}\n", resume_hint_line(session_id));
+    if restore_incomplete {
+        block.push_str(&format!("{}\n", terminal_recovery_hint_line()));
+    }
+    block
