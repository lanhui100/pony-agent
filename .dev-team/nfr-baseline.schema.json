{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NFRBaseline",
  "type": "object",
  "properties": {
    "external_call_timeout_ms": {
      "type": "integer",
      "maximum": 3000
    },
    "retry": {
      "type": "object",
      "properties": {
        "max_attempts": { "type": "integer" },
        "backoff_cap_ms": { "type": "integer" }
      },
      "required": ["max_attempts", "backoff_cap_ms"],
      "additionalProperties": false
    },
    "concurrency_lock": {
      "type": "string",
      "minLength": 1
    },
    "lock_scope_bounded": {
      "type": "boolean",
      "const": true
    },
    "lock_reentrancy_forbidden": {
      "type": "boolean",
      "const": true
    },
    "lock_acquisition_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "deadlock_watchdog_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "lock_forbidden_calls": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resolve_graph_run_for_retrieval",
          "load_graph_run",
          "load_execution_checkpoint",
          "load_active_graph_run_for_session"
        ]
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "format": { "type": "string", "enum": ["json"] },
        "trace_id_required": { "type": "boolean" }
      },
      "required": ["format", "trace_id_required"],
      "additionalProperties": false
    },
    "resource_release": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "external_call_timeout_ms",
    "retry",
    "concurrency_lock",
    "lock_scope_bounded",
    "lock_reentrancy_forbidden",
    "lock_acquisition_timeout_ms",
    "deadlock_watchdog_timeout_ms",
    "lock_forbidden_calls",
    "logging",
    "resource_release"
  ],
  "additionalProperties": false
}
