{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NFRBaseline",
  "type": "object",
  "properties": {
    "external_call_timeout_ms": {
      "type": "integer",
      "maximum": 3000
    },
    "retry": {
      "type": "object",
      "properties": {
        "max_attempts": { "type": "integer" },
        "backoff_cap_ms": { "type": "integer" },
        "backoff_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "wave-1 新增（additive-only）：基础退避（指数退避起点，毫秒）；与既有 backoff_cap_ms（退避上限）配对，二者必须同时声明。"
        }
      },
      "required": ["max_attempts", "backoff_cap_ms"],
      "additionalProperties": false
    },
    "concurrency_lock": {
      "type": "string",
      "minLength": 1
    },
    "lock_scope_bounded": {
      "type": "boolean",
      "const": true
    },
    "lock_reentrancy_forbidden": {
      "type": "boolean",
      "const": true
    },
    "lock_acquisition_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "deadlock_watchdog_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "lock_forbidden_calls": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resolve_graph_run_for_retrieval",
          "load_graph_run",
          "load_execution_checkpoint",
          "load_active_graph_run_for_session"
        ]
      }
    },
    "logging": {
      "type": "object",
      "description": "适用范围收窄为 logging_scope 声明的「新增结构化日志面」；既有风格（非 JSON）的锁中毒恢复诊断输出按 logging_legacy_eprintln_exempt + logging_eprintln_exempt_scope 豁免（含本波新增 1 处）。注意：当前全仓库无结构化日志面，本字段无代码级检查点，属 PA-119 债务（见 logging_compliance_claimed）。",
      "properties": {
        "format": { "type": "string", "enum": ["json"] },
        "trace_id_required": { "type": "boolean" },
        "trace_id_field": {
          "type": "string",
          "minLength": 1,
          "description": "wave-1 新增（additive-only）：承载 trace id 的 JSON 字段名（当前全仓库无结构化日志面，仍属 PA-119 债务，不主张已满足）。"
        },
        "trace_id": {
          "type": "boolean",
          "const": true,
          "description": "wave-65 增量声明（additive-only；此前未在 schema 声明属既有漂移，按 wave-61 先例声明而非剪除）：logging 必含 trace_id 的简写承诺。不进入 required，强制口径仍由 dev-nfr-lint.py 与 .dev-team/nfr-lint.py 的 trace_id_required 分支承担。"
        }
      },
      "required": ["format", "trace_id_required"],
      "additionalProperties": false
    },
    "logging_scope": {
      "type": "string",
      "description": "logging{format,trace_id_required} 的适用范围收窄声明（Lead 裁定：不引入结构化日志框架）。",
      "enum": ["new_structured_logging_surface_only"]
    },
    "logging_legacy_eprintln_exempt": {
      "type": "boolean",
      "description": "既有风格（非 JSON）eprintln 诊断输出豁免；豁免必须绑定 logging_debt_ref 债务单。字段名沿用 task-5 冻结名，语义以 logging_eprintln_exempt_scope 为准（不再声称仅覆盖 legacy）。",
      "const": true
    },
    "logging_debt_ref": {
      "type": "string",
      "description": "豁免到期条款所绑定的债务单（PA-119 结构化日志迁移）。",
      "const": "PA-119"
    },
    "logging_eprintln_exempt_scope": {
      "type": "string",
      "description": "豁免覆盖范围的显式声明：既有风格（非 JSON）的锁中毒恢复诊断输出，含本波新增的 1 处（history_commands.rs:456）。",
      "enum": ["existing_style_non_json_lock_poison_recovery_diagnostics"]
    },
    "logging_eprintln_exempt_covers_new_lines": {
      "type": "integer",
      "description": "本波被豁免覆盖的**新增** eprintln 诊断行数；minimum=1 以禁止「声明豁免却覆盖 0 处新增行」的不实声明。",
      "minimum": 1
    },
    "logging_compliance_claimed": {
      "type": "boolean",
      "description": "恒真防护：logging{format=json,trace_id_required} 当前无代码级检查点（PA-119 债务），本波不主张该 NFR 已满足，故必须为 false。",
      "const": false
    },
    "resource_release": {
      "type": "array",
      "items": { "type": "string" }
    },
    "observability": {
      "type": "object",
      "description": "wave-5 起在基线上扩展的观测面事实。wave-65 增量声明（此前未在 schema 声明属既有漂移，按 wave-61 先例声明而非剪除）。",
      "properties": {
        "exporter_flush_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000,
          "description": "导出器 flush 预算；网络类出口同样以 external_call_timeout_ms(<=3000) 为上限。"
        },
        "log_file_max_bytes": { "type": "integer", "minimum": 1 },
        "setting_precedence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["settings", "env", "default"] }
        },
        "cost_precision_decimals": { "type": "integer", "minimum": 0 },
        "cost_budget_semantics": { "type": "string", "minLength": 1 }
      },
      "required": [
        "exporter_flush_timeout_ms",
        "log_file_max_bytes",
        "setting_precedence",
        "cost_precision_decimals",
        "cost_budget_semantics"
      ],
      "additionalProperties": false
    },
    "external_call_timeout_exceptions": {
      "type": "array",
      "description": "external_call_timeout_ms（=3000，请求级外部往返预算）的显式例外登记。wave-61 起形成，wave-65 增量声明进入 schema。纪律：①每条必须说明为何不套基线上限并给出替代保证；②网络类出网一律仍受 3000ms 上限；③wave-55/56/61 的既有豁免不得剪除。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "code",
          "semantics",
          "why_not_base",
          "guarantee",
          "registered_at",
          "updated_at"
        ],
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "semantics": { "type": "string", "minLength": 1 },
          "why_not_base": { "type": "string", "minLength": 1 },
          "guarantee": { "type": "string", "minLength": 1 },
          "known_gap_ref": { "type": "string", "minLength": 1 },
          "l3p_blocking_resolution": { "type": "string", "minLength": 1 },
          "registered_at": { "type": "string", "minLength": 1 },
          "updated_at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "logging_eprintln_exempt_note": {
      "type": "string",
      "minLength": 1,
      "description": "wave-55 起追加的豁免说明（豁免覆盖的新增 eprintln 处数与「不含密文」事实）。wave-65 增量声明（此前未在 schema 声明属既有漂移）。"
    },
    "auto_continue_max": {
      "type": "integer",
      "const": 8,
      "description": "wave-1 新增（additive-only）：同一用户消息系列内连续自动续行硬上限，对应 MAX_CONSECUTIVE_AUTO_CONTINUES（契约 C1/C3）。"
    },
    "goal_store_atomic_write": {
      "type": "boolean",
      "const": true,
      "description": "wave-1 新增（additive-only）：goal JSON sidecar 必须原子写（*.tmp + rename），禁止原地覆写（契约 C2）。"
    },
    "wave18_secret_scan_gate": {
      "type": "object",
      "description": "wave-18 新增（additive-only，未进入顶层 required）：scripts/check-secrets.mjs 裸 64-hex 高熵规则的机械承诺，补充既有前缀规则盲区。",
      "properties": {
        "applicable": { "type": "boolean" },
        "rule_id": { "type": "string", "minLength": 1 },
        "match_min_hex_len": { "type": "integer", "const": 64 },
        "match_max_hex_len": { "type": "integer", "const": 64 },
        "must_match_64_hex_literal": { "type": "boolean", "const": true },
        "repo_scanned_files": { "type": "integer", "minimum": 1 },
        "true_positive_sites": { "type": "integer", "minimum": 1 },
        "false_positive_budget": { "type": "integer", "const": 0 },
        "observed_false_positives": { "type": "integer", "const": 0 },
        "git_sha_exempt_lengths": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "integer" }
        },
        "sha256_context_exempt": { "type": "boolean" },
        "existing_spec_assertions_preserved": { "type": "integer", "minimum": 1 },
        "exports_preserved": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "known_limitation": { "type": "string", "minLength": 1 }
      },
      "required": [
        "applicable",
        "rule_id",
        "match_min_hex_len",
        "match_max_hex_len",
        "must_match_64_hex_literal",
        "repo_scanned_files",
        "true_positive_sites",
        "false_positive_budget",
        "observed_false_positives",
        "git_sha_exempt_lengths",
        "sha256_context_exempt",
        "existing_spec_assertions_preserved",
        "exports_preserved",
        "known_limitation"
      ],
      "additionalProperties": false
    },
    "wave18_egress_default_disabled": {
      "type": "object",
      "description": "wave-18 新增（additive-only，未进入顶层 required）：PonySentry 默认零 egress 的机械承诺（client_token 默认 None、enabled 默认 false、token 仅来自环境变量）。",
      "properties": {
        "applicable": { "type": "boolean" },
        "default_client_token_is_none": { "type": "boolean", "const": true },
        "default_enabled": { "type": "boolean", "const": false },
        "token_env_only_source": { "type": "string", "const": "PONYSENTRY_CLIENT_TOKEN" },
        "hardcoded_token_fallback_forbidden": { "type": "boolean", "const": true },
        "enabled_env_default": { "type": "boolean", "const": false },
        "enabled_truthy_requires_explicit_non_false": { "type": "boolean", "const": true },
        "early_return_sites": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "early_return_sites_unchanged": { "type": "boolean", "const": true },
        "set_but_empty_is_false": { "type": "boolean", "const": true },
        "blank_only_is_false": { "type": "boolean", "const": true }
      },
      "required": [
        "applicable",
        "default_client_token_is_none",
        "default_enabled",
        "token_env_only_source",
        "hardcoded_token_fallback_forbidden",
        "enabled_env_default",
        "enabled_truthy_requires_explicit_non_false",
        "early_return_sites",
        "early_return_sites_unchanged",
        "set_but_empty_is_false",
        "blank_only_is_false"
      ],
      "additionalProperties": false
    },
    "wave18b_external_call_timeout_landing": {
      "type": "object",
      "description": "wave-18b 新增（additive-only，未进入顶层 required）：external_call_timeout_ms 在前端 telemetry.ts ingest fetch 的落地承诺（C8）。",
      "properties": {
        "applicable": { "type": "boolean" },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3000 },
        "timeout_ms_upper_bound": { "type": "integer", "const": 3000 },
        "sites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "mechanism": { "type": "string", "minLength": 1 },
        "signal_attached_to_fetch": { "type": "boolean", "const": true },
        "clear_timeout_after_settle_required": { "type": "boolean", "const": true },
        "abort_signal_timeout_forbidden": { "type": "boolean", "const": true },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "required": [
        "applicable",
        "timeout_ms",
        "timeout_ms_upper_bound",
        "sites",
        "mechanism",
        "signal_attached_to_fetch",
        "clear_timeout_after_settle_required",
        "abort_signal_timeout_forbidden",
        "evidence"
      ],
      "additionalProperties": false
    },
    "wave18b_scanner_linearity": {
      "type": "object",
      "description": "wave-18b 新增（additive-only，未进入顶层 required）：裸 64-hex 规则的整行线性时间承诺（C4-R3，对应 review-l3-scanner finding#4 二次方 DoS）。",
      "properties": {
        "applicable": { "type": "boolean" },
        "per_match_whole_line_work_forbidden": { "type": "boolean", "const": true },
        "context_precompute_per_line_required": { "type": "boolean", "const": true },
        "cache_bounded_max_entries": { "type": "integer", "minimum": 1 },
        "observed_single_line_4000_hex_ms": { "type": "integer", "minimum": 1 },
        "observed_split_lines_4000_hex_ms": { "type": "integer", "minimum": 1 },
        "observed_ratio": { "type": "integer", "minimum": 1 },
        "acceptance_max_ms_single_line_4000_hex": { "type": "integer", "minimum": 1 },
        "review_observed_1mb_single_line_ms": { "type": "integer", "minimum": 1 },
        "per_match_context_split_forbidden": { "type": "boolean", "const": true },
        "line_cache_key": { "type": "string", "const": "lineNumber" },
        "acceptance_max_ms_single_line_5mb": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "acceptance_max_ms_single_line_10mb": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "r3_observed_1mb_single_line_ms": { "type": "integer", "minimum": 1 },
        "r3_observed_5mb_single_line_ms": { "type": "integer", "minimum": 1 },
        "r4_candidate_observed_5mb_single_line_ms": { "type": "integer", "minimum": 1 },
        "r4_candidate_observed_10mb_single_line_ms": { "type": "integer", "minimum": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "required": [
        "applicable",
        "per_match_whole_line_work_forbidden",
        "context_precompute_per_line_required",
        "cache_bounded_max_entries",
        "observed_single_line_4000_hex_ms",
        "observed_split_lines_4000_hex_ms",
        "observed_ratio",
        "acceptance_max_ms_single_line_4000_hex",
        "review_observed_1mb_single_line_ms",
        "per_match_context_split_forbidden",
        "line_cache_key",
        "acceptance_max_ms_single_line_5mb",
        "acceptance_max_ms_single_line_10mb",
        "r3_observed_1mb_single_line_ms",
        "r3_observed_5mb_single_line_ms",
        "r4_candidate_observed_5mb_single_line_ms",
        "r4_candidate_observed_10mb_single_line_ms",
        "evidence"
      ],
      "additionalProperties": false
    },
    "team_tool_surface_exact_count": {
      "type": "integer",
      "const": 38,
      "description": "wave-61 新增（additive-only，未进入顶层 required）：模型可见工具面精确项数。29（W37-C1 × W42/PA-149 基线）+ 9 项团队工具（subagent/spawn_teammate/list_agents/send_message/interrupt_agent/drain_inbox/team_task_create/team_task_update/team_task_list）= 38；workflow 按 v1.2 C1.7 保持 Internal（实现是桩，orchestration.rs:286-297），不进模型面。契约：wave-61 C1-A1/C1-A8。"
    },
    "subagent_engine_registration_required_in": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["tauri", "harness", "tui"]
      },
      "description": "wave-61 新增（additive-only，未进入顶层 required）：必须经由 core 唯一注册点 crates/pony-agent-core/src/agent/runtime/builder.rs:79 AgentRuntimeBuilder::build() 获得 SubagentTurnEngine 的三条宿主。语义是「受益于注册」而非「必须修改这三处源码」——宿主侧 set_subagent_engine 出现次数必须为 0（C2-A2）。契约：wave-61 C2.1。"
    },
    "team_policy_prompt_injected_when_wired": {
      "type": "boolean",
      "const": true,
      "description": "wave-61 新增（additive-only，未进入顶层 required）：subagent_runtime_wired() 为 true 时必须在 System 稳定前缀层注入静态 Agent Team 策略段（标题行 `Agent Teams is available in this session`）；为 false 时完全不注入。契约：wave-61 C3-A1/C5-A1。"
    },
    "subagent_max_concurrent": {
      "type": "integer",
      "const": 2,
      "description": "wave-61 v1.2 复登（值不得改动，真值源 crates/pony-agent-core/src/agent/subagent_runtime.rs SUBAGENT_MAX_CONCURRENT）：子代理并发上限；口径见 wave-37 基线 nfr-baseline-wave37.json。契约：wave-61 C6.3/C6-A4。"
    },
    "subagent_turn_timeout_ms": {
      "type": "integer",
      "const": 120000,
      "description": "wave-61 v1.2 复登（值不得改动，真值源 orchestration.rs SUBAGENT_TURN_TIMEOUT_MS）：端到端子代理 turn 预算，非 external_call_timeout_ms(<=3000) 的请求级往返预算；与流式例外同性质，故独立字段登记。契约：wave-61 C6.3/C6-A4。"
    },
    "subagent_max_prompt_bytes": {
      "type": "integer",
      "const": 200000,
      "description": "wave-61 v1.2 复登（值不得改动，真值源 subagent_runtime.rs SUBAGENT_MAX_PROMPT_BYTES）：子代理 prompt 字节上限（超出即 prompt_too_large）。契约：wave-61 C6.3/C6-A4。"
    }
  },
  "required": [
    "external_call_timeout_ms",
    "retry",
    "concurrency_lock",
    "lock_scope_bounded",
    "lock_reentrancy_forbidden",
    "lock_acquisition_timeout_ms",
    "deadlock_watchdog_timeout_ms",
    "lock_forbidden_calls",
    "logging",
    "logging_scope",
    "logging_legacy_eprintln_exempt",
    "logging_debt_ref",
    "logging_eprintln_exempt_scope",
    "logging_eprintln_exempt_covers_new_lines",
    "logging_compliance_claimed",
    "resource_release"
  ],
  "additionalProperties": false
}
