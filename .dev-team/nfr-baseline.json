{
  "concurrency_lock": {
    "mechanism": "mutex",
    "required": true,
    "strategy": "content_hash_cas",
    "hash_algorithm": "sha256",
    "atomic_swap": true
  },
  "external_call_timeout_ms": 3000,
  "logging": {
    "format": "json",
    "trace_id": true,
    "structured": true
  },
  "sanitization": {
    "zero_trust": true,
    "redact_tokens": true,
    "redact_user_home": true,
    "max_depth": 32
  },
  "resource_release": {
    "bounded_queue": true,
    "max_queue_capacity": 1024,
    "fire_and_forget": true,
    "worker_thread": true
  },
  "retry": {
    "backoff_ms": 1000,
    "max_retries": 1
  },
  "pipeline_guardrails": {
    "max_middleware_timeout_ms": 3000,
    "max_recursion_depth": 16,
    "zero_business_logic_in_contracts": true,
    "fail_safe_on_panic": true,
    "supported_decisions": [
      "pass",
      "block",
      "mutate",
      "approval_required"
    ]
  }
}
