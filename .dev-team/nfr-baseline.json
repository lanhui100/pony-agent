{
  "concurrency_lock": {
    "mechanism": "mutex",
    "required": true
  },
  "external_call_timeout_ms": 3000,
  "logging": {
    "format": "json",
    "trace_id": true
  },
  "resource_release": {
    "bounded_queue": true,
    "fire_and_forget": true
  },
  "retry": {
    "backoff_ms": 1000,
    "max_retries": 1
  }
}
