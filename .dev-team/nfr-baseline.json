{
  "external_call_timeout_ms": 3000,
  "retry": {
    "max_attempts": 1,
    "backoff_cap_ms": 1000
  },
  "concurrency_lock": "mutex",
  "lock_scope_bounded": true,
  "lock_reentrancy_forbidden": true,
  "lock_acquisition_timeout_ms": 2000,
  "deadlock_watchdog_timeout_ms": 5000,
  "lock_forbidden_calls": [
    "resolve_graph_run_for_retrieval",
    "load_graph_run",
    "load_execution_checkpoint",
    "load_active_graph_run_for_session"
  ],
  "logging": {
    "format": "json",
    "trace_id_required": true
  },
  "resource_release": [
    "bounded_queue",
    "max_queue_capacity_1024",
    "fire_and_forget",
    "worker_thread_shutdown"
  ]
}
