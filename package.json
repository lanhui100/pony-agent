{
  "name": "pony-agent",
  "version": "0.1.110",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "dev:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-tauri-dev.ps1",
    "dev:tauri:full": "npm run dev:tauri",
    "dev:tauri:cool": "npm run dev:tauri",
    "dev:tauri:fresh": "npm run clean:tauri:light && npm run dev:tauri",
    "dev:tauri:cool:fresh": "npm run clean:tauri:light && npm run dev:tauri",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml --target-dir target-check",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --target-dir target-test",
    "cargo:test:lib": "cargo test --manifest-path src-tauri/Cargo.toml --lib --target-dir target-test",
    "cargo:test:regression": "cargo test --manifest-path src-tauri/Cargo.toml --test session_regression --test provider_registry_regression --test tool_router_regression --target-dir target-test",
    "cargo:check:shared": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-rust-target.ps1 check check",
    "cargo:test:shared": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-rust-target.ps1 test test",
    "cargo:test:exact": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-rust-target.ps1 exact-a test",
    "cargo:test:exact:b": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-rust-target.ps1 exact-b test",
    "cargo:test:exact:c": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-rust-target.ps1 exact-c test",
    "clean:tauri:light": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-targets.ps1",
    "clean:tauri:deep": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-targets.ps1 -Deep",
    "git:diagnose:objects": "git count-objects -vH",
    "git:gc": "git gc",
    "git:gc:deep": "git reflog expire --expire-unreachable=now --all && git gc --prune=now",
    "schemas:normalize": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/normalize-generated-schemas.ps1",
    "schemas:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/normalize-generated-schemas.ps1 -Watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:ui-guard": "vitest run --coverage tests/App.spec.ts tests/HomeWorkspace.spec.ts tests/HomeSessionSidebar.spec.ts",
    "test:e2e": "npm run build && playwright test",
    "test:tauri:smoke": "node scripts/tauri-smoke.js",
    "secrets:check": "node scripts/check-secrets.mjs --staged",
    "secrets:check:all": "node scripts/check-secrets.mjs --all",
    "verify": "npm run version:check && npm run secrets:check && npm run test:unit && npm run build && npm run cargo:check:shared",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4175",
    "tauri": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH%&& tauri",
    "version": "node scripts/release.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release": "node scripts/release.mjs --push",
    "version:core": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Target core",
    "version:tauri": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Target tauri",
    "version:minor": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Segment minor",
    "version:major": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Segment major",
    "version:dryrun": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -DryRun",
    "version:show": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Get-Content .version.json | ConvertFrom-Json | ForEach-Object { Write-Host ('core: {0}.{1}.{2}' -f $_.core.major, $_.core.minor, $_.core.patch); Write-Host ('tauri: {0}.{1}.{2}' -f $_.tauri.major, $_.tauri.minor, $_.tauri.patch) }\""
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "8.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.3",
    "misans": "^4.1.0",
    "motion-v": "^2.3.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34"
  }
}
