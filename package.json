{
  "name": "pony-agent",
  "version": "0.1.204",
  "private": true,
  "type": "module",
  "scripts": {
    "cli:build": "cargo build --release --bin pony --bin ponycli --manifest-path crates/pony-agent-core/Cargo.toml && node scripts/install-cli.mjs",
    "cli:install": "npm run cli:build",
    "tui": "pony",
    "dev": "vite --configLoader native",
    "dev:tauri": "node scripts/run-portable.mjs dev:tauri",
    "dev:tauri:full": "npm run dev:tauri",
    "dev:tauri:cool": "npm run dev:tauri",
    "dev:tauri:fresh": "npm run clean:tauri:light && npm run dev:tauri",
    "dev:tauri:cool:fresh": "npm run clean:tauri:light && npm run dev:tauri",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "contract:check": "node scripts/check-ts-contract.mjs",
    "contract:cli": "node scripts/check-cli-release-contract.mjs",
    "adr:check": "bash .agents/skills/write-adr/verify-note.sh && bash .meta/gates/archive-verify.sh check",
    "decisions:check": "npm run adr:check",
    "audit:selftest": "bash scripts/audit/selftest.sh",
    "audit:verdict": "bash scripts/audit/verdict.sh",
    "audit:ratchet": "bash scripts/audit/ratchet.sh",
    "size:check": "node scripts/check-file-size.mjs --baseline scripts/file-size-baseline.json",
    "size:check:json": "node scripts/check-file-size.mjs --baseline scripts/file-size-baseline.json --json",
    "size:check:update": "node scripts/check-file-size.mjs --update-baseline scripts/file-size-baseline.json",
    "rust:lint": "node scripts/check-clippy-baseline.mjs",
    "rust:lint:json": "node scripts/check-clippy-baseline.mjs --json",
    "rust:lint:update": "node scripts/check-clippy-baseline.mjs --update-baseline",
    "rust:lint:selftest": "node scripts/check-clippy-baseline.spec.mjs",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml --target-dir target-check",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --target-dir target-test",
    "cargo:test:lib": "cargo test --manifest-path src-tauri/Cargo.toml --lib --target-dir target-test",
    "cargo:test:regression": "cargo test --manifest-path src-tauri/Cargo.toml --test session_regression --test provider_registry_regression --test tool_router_regression --target-dir target-test",
    "cargo:check:shared": "node scripts/invoke-rust-target.mjs check check",
    "cargo:test:shared": "node scripts/invoke-rust-target.mjs test test",
    "cargo:test:exact": "node scripts/invoke-rust-target.mjs exact-a test",
    "cargo:test:exact:b": "node scripts/invoke-rust-target.mjs exact-b test",
    "cargo:test:exact:c": "node scripts/invoke-rust-target.mjs exact-c test",
    "clean:tauri:light": "node scripts/run-portable.mjs clean:light",
    "clean:tauri:deep": "node scripts/run-portable.mjs clean:deep",
    "clean:incremental": "node scripts/run-portable.mjs clean:incremental",
    "clean:frontend": "node scripts/run-portable.mjs clean:frontend",
    "build:accel": "bash scripts/build-accel-check.sh",
    "build:accel:json": "bash scripts/build-accel-check.sh --json",
    "bench:build": "bash scripts/build-bench.sh",
    "cross:status": "bash scripts/cross-target-status.sh",
    "portable:ps1": "bash scripts/check-ps1-portability.sh",
    "portable:ps1:selftest": "bash scripts/check-ps1-portability.spec.sh",
    "check:fast": "node scripts/invoke-rust-target.mjs check check -p pony-agent-core --lib",
    "artifacts:status": "bash scripts/artifacts-status.sh",
    "artifacts:check": "bash scripts/artifacts-status.sh --budget",
    "git:diagnose:objects": "git count-objects -vH",
    "git:gc": "git gc",
    "git:gc:deep": "git reflog expire --expire-unreachable=now --all && git gc --prune=now",
    "git:prune": "node scripts/git-prune-worktrees.mjs",
    "git:prune:apply": "node scripts/git-prune-worktrees.mjs --apply",
    "git:prune:selftest": "node scripts/git-prune-worktrees.spec.mjs",
    "schemas:normalize": "node scripts/run-portable.mjs schemas:normalize",
    "schemas:watch": "node scripts/run-portable.mjs schemas:watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:ui-guard": "vitest run --coverage tests/App.spec.ts tests/HomeWorkspace.spec.ts tests/HomeSessionSidebar.spec.ts",
    "test:e2e": "npm run build && playwright test",
    "test:tauri:smoke": "node scripts/tauri-smoke.js",
    "secrets:check": "node scripts/check-secrets.mjs --staged",
    "secrets:check:all": "node scripts/check-secrets.mjs --all",
    "verify": "npm run version:check && npm run git:guard:selftest && npm run git:prune:selftest && npm run release:push:selftest && npm run install-cli:selftest && npm run adr:check && npm run secrets:check:all && npm run backlog:gate && npm run test:unit && npm run build && npm run contract:check && npm run contract:cli && npm run size:check && npm run rust:lint:selftest && npm run rust:lint && npm run rust:lint:tauri && npm run portable:ps1 && npm run portable:ps1:selftest && npm run cargo:check:shared && npm run ext:check",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4175",
    "tauri": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH%&& tauri",
    "version": "node scripts/release.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release": "node scripts/release.mjs",
    "release:push": "node scripts/release.mjs --push",
    "release:push:selftest": "node scripts/release-push.spec.mjs",
    "install-cli:selftest": "node scripts/install-cli.spec.mjs",
    "git:guard:selftest": "bash scripts/git-guard.spec.sh",
    "version:core": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Target core",
    "version:tauri": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Target tauri",
    "version:minor": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Segment minor",
    "version:major": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Segment major",
    "version:dryrun": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -DryRun",
    "version:show": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Get-Content .version.json | ConvertFrom-Json | ForEach-Object { Write-Host ('core: {0}.{1}.{2}' -f $_.core.major, $_.core.minor, $_.core.patch); Write-Host ('tauri: {0}.{1}.{2}' -f $_.tauri.major, $_.tauri.minor, $_.tauri.patch) }\"",
    "ext:check": "node scripts/gen-extension-points.mjs --check",
    "conformance:test": "cargo test -p pony-agent-core --test conformance",
    "backlog:lint": "node scripts/backlog.mjs lint",
    "backlog:doctor": "node scripts/backlog.mjs doctor",
    "backlog:gate": "node scripts/backlog.mjs lint && node scripts/backlog.mjs doctor && node scripts/backlog.mjs verify-archive",
    "backlog:list": "node scripts/backlog.mjs list",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "node -e \"const cp=require('child_process');try{cp.execFileSync('git',['rev-parse','--is-inside-work-tree'],{stdio:'ignore'});let cur='';try{cur=cp.execFileSync('git',['config','--get','core.hooksPath'],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()}catch{};if(cur!=='.githooks')cp.execFileSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})}catch{}\"",
    "artifacts:spec": "bash scripts/artifacts-tools.spec.sh",
    "clean:targets": "bash scripts/clean-targets.sh",
    "rust:lint:tauri": "node scripts/check-clippy-baseline.mjs --package pony-agent --baseline scripts/clippy-baseline-src-tauri.json",
    "rust:lint:tauri:json": "node scripts/check-clippy-baseline.mjs --package pony-agent --baseline scripts/clippy-baseline-src-tauri.json --json",
    "rust:lint:tauri:update": "node scripts/check-clippy-baseline.mjs --package pony-agent --baseline scripts/clippy-baseline-src-tauri.json --update-baseline"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "8.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.3",
    "misans": "^4.1.0",
    "motion-v": "^2.3.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34"
  }
}
